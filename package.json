{
  "name": "fedo",
  "version": "2.5.0",
  "description": "Fedo: ویرایشگر Markdown فارسی",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never",
    "release:win": "vite build && electron-builder --win --publish always"
  },
  "keywords": [],
  "author": "Behzad",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "diff": "^9.0.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "katex": "^0.19.1",
    "mermaid": "^12.2.0",
    "png-to-ico": "^3.0.2",
    "resedit": "^3.1.0",
    "vite": "^8.3.5"
  },
  "productName": "Fedo",
  "build": {
    "appId": "app.neveshtar.editor",
    "productName": "Fedo",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "build/logos/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico",
      "artifactName": "Fedo-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Fedo",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "en_US"
      ],
      "artifactName": "Fedo-Setup-${version}.${ext}"
    },
    "afterPack": "build/after-pack.js",
    "publish": {
      "provider": "github",
      "owner": "behzadmirzaee",
      "repo": "Fedo",
      "releaseType": "release"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/behzadmirzaee/Fedo.git"
  }
}
